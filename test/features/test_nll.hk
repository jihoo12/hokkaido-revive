// NLL Borrow Checker Tests
// Exit code: 42
//
// Tests for valid programs that should compile and run:
// 1. Sequential mutable borrows (valid — NLL)
// 2. Cross-function shared borrow (valid)
// 5. Return parameter borrow (valid)

package main

fn test_sequential() -> int {
    let a: int = 10
    let w1: &mut int = &mut a
    *w1 = 20
    let w2: &mut int = &mut a
    *w2 = 30
    return *w2
}

fn read_val(x: &int) -> int {
    return *x
}

fn mutate_val(x: &mut int) -> void {
    *x = 99
}

fn test_crossfn_shared() -> int {
    let a: int = 10
    let b: int = read_val(&a)
    let c: int = read_val(&a)
    return b + c
}

fn return_param_good(x: &int) -> &int {
    return x
}

fn test_return_param() -> int {
    let a: int = 42
    let r: &int = return_param_good(&a)
    return *r
}

struct Counter {
    val: int
}

impl Counter {
    fn get(self: Counter) -> int {
        return self.val
    }
    fn inc(self: Counter) -> void {
        self.val = self.val + 1
    }
}

fn test_impl_method() -> int {
    let c: Counter = Counter { val: 10 }
    let v: int = c.get()
    return v
}

fn test_match_borrow() -> int {
    let x: int = 10
    let r: &int = &x
    let val: int = match true {
        _ => *r
    }
    return val
}

fn main() -> int {
    let code: int = test_sequential()
    let code2: int = test_crossfn_shared()
    let code3: int = test_return_param()
    let code4: int = test_match_borrow()
    let code5: int = test_impl_method()
    return code2 + code3 + code + code4 + code5
}
